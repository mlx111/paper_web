# Application
APP_NAME=MyPaperWeb
APP_VERSION=1.0.0
DEBUG=true
HOST=127.0.0.1
PORT=8080

# Database and cache
DB_URL=mysql+aiomysql://root:password@localhost:3306/paper?charset=utf8
REDIS_URL=redis://localhost:6379/0

# Mail
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_authorization_code
MAIL_FROM=your_email@example.com
MAIL_FROM_NAME=MyPaperWeb
MAIL_SSL_TLS=true
MAIL_STARTTLS=false

# LLM and embeddings
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-flash
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
RAG_MODEL=qwen3.5-flash
RAG_TOP_K=3
EMBEDDING_DIM=1024

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
MILVUS_COLLECTION=mypaperweb_embeddings

# Chunking and retrieval
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100
CHUNK_SIZE=1000
MAX_SPLIT_CHAR_NUMBER=1000
SIMILARITY_THRESHOLD=5
RERANK_API_KEY=your_rerank_api_key
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=gte-rerank

# Search and research
WEB_SEARCH_KEY=your_web_search_key
WEB_SEARCH_URL=https://api.bocha.cn/v1/web-search
TAVILY_API_KEY=your_tavily_api_key
CORE_API_KEY=your_core_api_key

# Memory summary
SUMMARY_TRIGGER=10
SUMMARY_KEEP_LAST=6

# Session temporary files
TEMP_FILE_MAX_COUNT=5
TEMP_FILE_MAX_SIZE_MB=20
TEMP_FILE_MAX_TOTAL_SIZE_MB=50
TEMP_FILE_TTL_SECONDS=7200
